<!DOCTYPE html>
<html lang="tr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Video Player</title>
<style>
  html, body { margin: 0; height: 100%; background: #000; overflow: hidden; }
  body { display: flex; align-items: center; justify-content: center; font-family: system-ui, sans-serif; }
  #wrap { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; flex-direction: column; }
  video { width: 100%; height: 100%; max-height: 100vh; outline: none; }
  .spinner { width: 40px; height: 40px; border: 4px solid #333; border-top-color: #6366f1; border-radius: 50%; animation: spin 1s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  .msg { color: #fff; text-align: center; padding: 20px; line-height: 1.6; }
  .msg h2 { color: #f87171; }
  .msg code { background: #1a1a24; padding: 4px 8px; border-radius: 6px; color: #a5b4fc; font-size: 0.9em; word-break: break-all; }
</style>
</head>
<body>
<div id="wrap"></div>

<script>
// ==== BURAYI KENDİ REPONA GÖRE AYARLA ====
const CONFIG = {
  user:   'scptr1155-gif',
  repo:   'video-star',
  branch: 'main',
  folder: 'videos',
  ext:    'mp4' // Varsayılan uzantı
};
// =========================================

const wrap = document.getElementById('wrap');
const params = new URLSearchParams(location.search);
const videoId = params.get('id');
const videoExt = params.get('ext') || CONFIG.ext;

function showError(title, detail) {
  wrap.innerHTML = `<div class="msg"><h2>${title}</h2><p>${detail}</p></div>`;
}

function loadVideo() {
  if (!videoId) return showError('Video ID Eksik', 'Kullanım: <code>player.html?id=video1</code>');

  // Dosya adındaki boşlukları ve Türkçe karakterleri URL'ye uygun hale getir
  const safeId = encodeURIComponent(videoId);
  const path = CONFIG.folder ? `${CONFIG.folder}/${safeId}.${videoExt}` : `${safeId}.${videoExt}`;
  
  const urls = [
    `https://raw.githubusercontent.com/${CONFIG.user}/${CONFIG.repo}/${CONFIG.branch}/${path}`,
    `https://cdn.jsdelivr.net/gh/${CONFIG.user}/${CONFIG.repo}@${CONFIG.branch}/${path}`
  ];

  wrap.innerHTML = `<div class="spinner"></div>`;

  const video = document.createElement('video');
  video.controls = true;
  video.autoplay = true;
  video.playsInline = true;
  video.preload = 'metadata';

  // İki kaynağı da dene (Raw ve jsDelivr)
  urls.forEach(url => {
    const source = document.createElement('source');
    source.src = url;
    source.type = videoExt === 'webm' ? 'video/webm' : 'video/mp4';
    video.appendChild(source);
  });

  video.addEventListener('loadedmetadata', () => {
    wrap.innerHTML = '';
    wrap.appendChild(video);
  });

  video.addEventListener('error', () => {
    showError('Video Bulunamadı', `
      Aradığın ID: <code>${videoId}</code><br><br>
      Dosyanın repoda şu yolda olduğundan emin ol:<br>
      <code>${CONFIG.folder}/${videoId}.${videoExt}</code><br><br>
      <b>Not:</b> Dosya adında boşluk varsa, GitHub'da ismini <b>alt çizgi (_)</b> ile değiştir.
    `);
  });

  video.load();
}

loadVideo();
</script>
</body>
</html>
